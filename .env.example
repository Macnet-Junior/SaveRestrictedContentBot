# Telegram Bot Configuration
# Get API_ID and API_HASH from: https://my.telegram.org/apps

API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# SESSION: Generate using generate_session.py script locally
# Instructions: Run `python generate_session.py` and paste the output here
SESSION=your_session_string_here

# Optional Settings
FORCESUB=  # Channel/Group ID for force subscription (leave empty if not using)
AUTH=      # Your Telegram user ID as admin (leave empty if not using)

# Render Configuration (auto-set on Render)
PORT=8080
